# Copia este archivo como .env y completa los valores.
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# ── Base de datos (MongoDB local) ────────────────────────────────
DB_URI=mongodb://127.0.0.1:27017/clinica_monte_tabor

# ── JWT ──────────────────────────────────────────────────────────
JWT_secret_key=cambia_esto_por_una_cadena_larga_y_aleatoria

# ── URLs locales ─────────────────────────────────────────────────
# Portal público del paciente (link de retorno tras pagar).
FRONTEND_URL=http://localhost:5174
# URL de este backend. Se usa para armar las URLs de los archivos subidos en modo local.
# Si vas a usar la app móvil en un teléfono, pon aquí la IP de tu PC (ej. http://192.168.1.10:4000)
# para que el teléfono pueda cargar las imágenes.
BACKEND_PUBLIC_URL=http://localhost:4000
# Orígenes web extra permitidos por CORS, separados por coma (opcional).
EXTRA_ALLOWED_ORIGINS=

# ── Cloudinary (opcional) ────────────────────────────────────────
# Vacío = las imágenes y documentos se guardan en backend/uploads (modo local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Correo saliente: nodemailer con Gmail (opcional) ─────────────
# USER_PASSWORD es una contraseña de aplicación de Gmail (Cuenta de Google > Seguridad >
# Contraseñas de aplicaciones), no la contraseña normal.
# Vacío = los correos (códigos de verificación, contraseñas) se imprimen en la consola del backend.
USER_EMAIL=tu_correo@gmail.com
USER_PASSWORD=tu_contraseña_de_aplicacion

# ── Wompi (opcional, pagos en línea; requiere internet) ──────────
GRANT_TYPE=
AUDIENCE=
CLIENT_ID=
CLIENT_SECRET=
