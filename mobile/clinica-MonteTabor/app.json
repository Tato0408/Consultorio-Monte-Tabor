{
  "expo": {
    "name": "Monte Tabor",
    "slug": "clinica-MonteTabor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoIconoAppRedondo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoAppForegroundAdaptativo.png",
        "backgroundColor": "#1066CF"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.tatonoto02.clinicaMonteTabor",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/logoIconoAppRedondo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logoConsultorioSInFondo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logoIconoAppRedondo.png",
          "color": "#3B6FCA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3e584f16-53de-49b0-9e4e-141b25214de2"
      }
    }
  }
}
